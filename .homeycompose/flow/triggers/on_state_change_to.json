        { "id": "STARTED", "title": { "fr": "Allumé", "en": "Started" } },
        { "id": "STOPPING", "title": { "fr": "En arrêt", "en": "Stopping" } },
        { "id": "FAULTED", "title": { "fr": "En défaut", "en": "Faulted" } },
