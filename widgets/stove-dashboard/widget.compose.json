{
  "name": {
    "fr": "État du poêle",
    "en": "Stove status"
  },
  "height": 115,
  "devices": {
    "type": "app",
    "singular": true,
    "filter": {
      "class": "heater",
      "capabilities": "target_temperature,measure_temperature,target_power,target_fan_speed,stove_state"
    }
  },
  "api": {
    "getStoveDashboardData": {
      "method": "GET",
      "path": "/state/:deviceId"
    }
  }
}
